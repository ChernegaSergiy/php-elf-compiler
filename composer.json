{
    "name": "chernegasergiy/trypillia-compiler",
    "description": "Ahead-of-time compiler for the Trypillia language that emits native x86_64 ELF binaries directly from PHP.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Serhii Cherneha",
            "email": "chernegasergiy3@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "ChernegaSergiy\\TrypilliaCompiler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChernegaSergiy\\TrypilliaCompiler\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/trypillia"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
